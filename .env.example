# Copy to .env in the repository root. Never commit .env or real keys.
# Existing process environment variables take precedence over .env.

# Azure: use the identity from `az login` (no API key required).
OPENAI_AUTH=azure-cli
OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1/
# Azure uses your deployment name here.
OPENAI_MODEL=gpt-6-luna
AZURE_TOKEN_SCOPE=https://ai.azure.com/.default

# OpenAI public API alternative: replace the values above with:
# OPENAI_AUTH=api-key
# OPENAI_BASE_URL=https://api.openai.com/v1/
# OPENAI_MODEL=YOUR_RESPONSES_COMPATIBLE_MODEL
# OPENAI_API_KEY=YOUR_API_KEY

# Azure API-key alternative: keep the Azure base URL and deployment;
# set OPENAI_AUTH=api-key and OPENAI_API_KEY to your Azure resource key.

# Demo 1 also calls the JEV API (not an OpenAI-compatible endpoint).
# Put a real key ONLY in your ignored local .env, never in this example.
JEV_AUTH=api-key
JEV_API_KEY=YOUR_JEV_API_KEY
JEV_MODEL=jev-latest

# Windows alternative: read the already saved credential without a plaintext key.
# Set JEV_AUTH=windows-credential and remove/leave unused JEV_API_KEY.
JEV_CREDENTIAL_TARGET=TypeSafe/Jev/APIKey
